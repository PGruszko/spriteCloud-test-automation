		{
			"name": "Update User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test 1: Check that status code is 200",
							"pm.test(\"Should get a successful response\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test 2: Verify response contains required fields (name, job, updatedAt)",
							"pm.test(\"Response contains required fields (name, job, updatedAt)\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('name');",
							"    pm.expect(jsonData).to.have.property('job');",
							"    pm.expect(jsonData).to.have.property('updatedAt');",
							"});",
							"",
							"// Test 3: Verify the response name matches the request body name",
							"pm.test(\"Response name matches the request body\", function () {",
							"    var jsonData = pm.response.json();",
							"    var requestBody = JSON.parse(pm.request.body.raw);",
							"    pm.expect(jsonData.name).to.eql(requestBody.name);",
							"});",
							"",
							"// Test 4: Verify the response job matches the request body job",
							"pm.test(\"Response job matches the request body\", function () {",
							"    var jsonData = pm.response.json();",
							"    var requestBody = JSON.parse(pm.request.body.raw);",
							"    pm.expect(jsonData.job).to.eql(requestBody.job);",
							"});",
							"",
							"// Test 5: Verify updatedAt field exists and is a valid timestamp",
							"pm.test(\"updatedAt field exists and is a valid timestamp\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.updatedAt).to.exist;",
							"    var timestamp = new Date(jsonData.updatedAt);",
							"    pm.expect(timestamp.toString()).to.not.equal('Invalid Date');",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
