	"item": [
		{
			"name": "List of Users",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test that response status is 200",
							"pm.test(\"Should get a successful response\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Parse response JSON",
							"let jsonData = pm.response.json();",
							"",
							"// Test that 'page' key exists and equals 1",
							"pm.test(\"Page 1 verification\", function () {",
							"    pm.expect(jsonData).to.have.property('page', 1);",
							"});",
							"",
							"// Test that 'data' is an array",
							"pm.test(\"The data comes back as a list\", function () {",
							"    pm.expect(jsonData).to.have.property('data').that.is.an('array');",
							"});",
							"",
							"// Test that each user object in 'data' contains expected keys",
							"pm.test(\"Every user has all their info\", function () {",
							"    if (Array.isArray(jsonData.data)) {",
							"        jsonData.data.forEach(function(user) {",
							"            pm.expect(user).to.have.all.keys('id', 'email', 'first_name', 'last_name', 'avatar');",
							"        });",
							"    } else {",
							"        pm.expect.fail(\"'data' is not an array\");",
							"    }",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [
					{
						"key": "x-api-key",
						"value": "{{apiKey}}"
					}
				],
				"url": {
					"raw": "{{baseURL}}/api/users",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"api",
						"users"
					],
					"query": [
						{
							"key": "page",
							"value": "2",
							"disabled": true
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Successful Login",
			"event": [
