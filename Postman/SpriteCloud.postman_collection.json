							"// Make sure we get a 400 since the password is missing",
							"pm.test(\"Should return a 400 bad request\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"// Check that the API actually tells us what went wrong",
							"pm.test(\"Response should include an error field\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"error\");",
							"});",
							"",
							"// Verify we're getting the right error message back",
							"pm.test(\"Error message should say the password is missing\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.error).to.eql(\"Missing password\");",
							"});"
